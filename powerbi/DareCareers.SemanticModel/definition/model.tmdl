model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["DataRoot","Attendance","ZoomStaging","Learners","Participation","Assessment","fnTrack","Status","Cohorts","AttendanceSummary","LearnerCohortStart","_Measures"]

ref table Attendance
ref table Learners
ref table Participation
ref table Assessment
ref table Cohorts
ref table Weeks
ref table Date
ref table _Measures

ref cultureInfo en-US

